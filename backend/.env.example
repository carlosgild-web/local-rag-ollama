# Copy to .env and adjust. All variables are optional; defaults shown.

# Paths
DATA_DIR=./data
# Built web UI. Empty = backend/static (Docker), then ../frontend/dist.
# STATIC_DIR=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=llama3.1
EMBEDDING_MODEL=bge-m3

# Retrieval defaults
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_PCT=0.12
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
RERANK_ENABLED=false
LLM_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192

# OCR fallback for low-text-yield PDF pages (scanned documents)
OCR_LANG=eng+spa
OCR_MIN_TEXT_CHARS=20
# Only needed if tesseract isn't on PATH or its tessdata isn't writable
# (e.g. a per-user install, see docs/decisions/0002-tesseract-user-tessdata.md)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Users\<you>\.tessdata

# Jobs (one in-process worker)
JOB_POLL_INTERVAL_SECONDS=1.0
JOB_MAX_RETRIES=2
MAX_UPLOAD_MB=100

# File watching (set true when bind-mounted in a container)
WATCH_POLLING=false

# Logging
LOG_LEVEL=INFO

# Developer only: make the troubleshooter show a failure on purpose.
# Comma list of: sqlite, vector_store, ollama_down, ollama_version,
# model_missing, low_memory, worker. Leave empty in normal use.
# SIMULATE_FAULTS=

# Shown on the simulated L2 ticket instead of this machine's real
# computer and user name, e.g. for public screenshots.
# SUPPORT_COMPUTER_NAME=DEMO-LAPTOP
# SUPPORT_USER_NAME=demo.user
