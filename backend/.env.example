# Copy to .env and adjust. All variables are optional; defaults shown.

# Paths
DATA_DIR=./data

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=llama3.1
EMBEDDING_MODEL=bge-m3

# Retrieval defaults
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_PCT=0.12
RETRIEVAL_TOP_K=5
LLM_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192

# File watching (set true when bind-mounted in a container)
WATCH_POLLING=false

# Logging
LOG_LEVEL=INFO
